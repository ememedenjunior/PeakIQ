PORT=5000
MONGODB_URI=mongodb+srv://emexstores:eetqmibS0B4zC5Yi@cluster0.nd2mvfv.mongodb.net/?appName=Cluster0
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=sk_test_f3a5a1ba517376a8fc07376b6c169e2a4aaced6b

# ---- Deployment ----
# Number of reverse proxies in front of the API (1 for nginx/Render/Fly/Heroku). Needed for correct rate limiting.
TRUST_PROXY=
# Serve the built client from this server (true by default when client/dist exists)
SERVE_CLIENT=true
# Extra allowed browser origins, comma separated (only if the client is hosted on another domain)
CORS_ORIGINS=
# Set true to log CSP violations without blocking while you verify a new deployment
CSP_REPORT_ONLY=false

# ---- Course workflow ----
# Every lesson needs a test before a course can be published
REQUIRE_LESSON_QUIZ=true

# ---- Live classes ----
LIVE_MAX_VIEWERS=30
LIVE_HOST_GRACE_SECONDS=90
LIVE_MAX_HOURS=6
# STUN finds direct routes. TURN relays video for students behind strict firewalls: strongly recommended in production.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# coturn "use-auth-secret" (preferred: short-lived credentials are minted per student)
TURN_SECRET=
# ...or fixed credentials
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=21600

# ---- Seeding (optional) ----
# INSTRUCTOR_EMAIL=teacher@example.com
# INSTRUCTOR_PASSWORD=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

